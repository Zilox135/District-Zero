<configs>
<append xpath="/entity_classes">
<entity_class name="robotDZOmegaprime" extends="robotTemplateHostile">
	<property name="Tags" value="entity,zombie,walker,robot" />
	<property name="Mesh" value="#@modfolder:Resources/dz_omegaprime_bundle.unity3d?DZ_Omegaprime" />
	<property name="AltMats" value="#@modfolder:Resources/dz_omegaprime_bundle.unity3d?M_Robot1_Skin 2,#@modfolder:Resources/dz_omegaprime_bundle.unity3d?M_Robot1_Skin 3,#@modfolder:Resources/dz_omegaprime_bundle.unity3d?M_Robot1_Skin 4" />
	<property name="PhysicsBody" value="robotDZOmegaprimeBody" />
	<property name="Mass" value="200" />
	<property name="ModelType" value="Standard" />
	<property name="RootMotion" value="true" />
	<property name="HasDeathAnim" value="true" />
	<property name="UserSpawnType" value="Menu"/>
	<property name="WalkType" value="7" />
	<property name="LookAtAngle" value="0"/>
	<property name="CrouchType" value="0" />
	
	<property name="HandItem" value="meleeHandRobotStandard" />
	
	<property name="MoveSpeedAggro" value="0.3, 1.25" />
	
	<drop event="Harvest" name="resourceElectricParts" count="0" tool_category="Disassemble" />
	<drop event="Harvest" name="resourceElectricParts" tag="salvageHarvest" count="2" />
	<drop event="Harvest" name="resourceMechanicalParts" tag="salvageHarvest" count="1" />
	<drop event="Harvest" name="resourceSpring" tag="salvageHarvest" count="1" />
	<drop event="Harvest" name="resourceScrapIron" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceScrapBrass" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceScrapLead" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceNanoChip" tag="salvageHarvest" count="1" />	
	<drop event="Harvest" name="resourceScrapIron" tag="allToolsHarvest" count="5" />	

	<effect_group name="Base Effects">
		<passive_effect name="HealthMax" operation="base_set" value="200" />		
	</effect_group>
</entity_class>


<entity_class name="robotDZOmegaprimeOvercharged" extends="robotDZOmegaprime">
	<property name="Tags" value="entity,zombie,walker,robot,feral,overcharged" />
	<property name="UserSpawnType" value="Menu"/>

	<!-- Gameplay -->
	<property name="DismemberMultiplierHead" value=".7" /><property name="DismemberMultiplierArms" value=".7" /><property name="DismemberMultiplierLegs" value=".7" /><!-- Feral -->
	<property name="PainResistPerHit" value=".7" /><!-- Feral -->
	<property name="MoveSpeedAggro" value="0.5, 1.35" />
	<property name="HandItem" value="meleeHandRobotOvercharged" />
	<property name="ExperienceGain" value="750" /><!-- XP grunt feral -->
	<property name="LootDropProb" value=".03" /> <!-- Feral -->
	
	<drop event="Harvest" name="resourceElectricParts" count="0" tool_category="Disassemble" />
	<drop event="Harvest" name="resourceElectricParts" tag="salvageHarvest" count="2" />
	<drop event="Harvest" name="resourceMechanicalParts" tag="salvageHarvest" count="1" />
	<drop event="Harvest" name="resourceSpring" tag="salvageHarvest" count="1" />
	<drop event="Harvest" name="resourceScrapIron" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceScrapBrass" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceScrapLead" tag="salvageHarvest" count="15" />
	<drop event="Harvest" name="resourceNanoChip" tag="salvageHarvest" count="1" />	
	<drop event="Harvest" name="resourceScrapIron" tag="allToolsHarvest" count="5" />	

	<effect_group name="Base Effects">
		<passive_effect name="HealthMax" operation="base_set" value="400" />
	</effect_group>
	
	<effect_group name="Extra Effects">			
		<triggered_effect trigger="onSelfFirstSpawn" action="AddBuff" buff="buffEnemyOvercharged">
			<requirement name="EntityTagCompare" tags="overcharged" />		
		</triggered_effect>	
	</effect_group>	
</entity_class>

<entity_class name="robotDZOmegaprimeRadiated" extends="robotDZOmegaprimeOvercharged">
