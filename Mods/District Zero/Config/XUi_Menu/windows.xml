<configs>

	<!-- Point the main menu background video at the file inside this mod.
	     No extension: the engine probes .webm (desktop) then .mp4. -->
	<set xpath="//window[@name='menuBackground']/video[@name='videoTexture']/@uri">@modfolder:Video/DistrictZero</set>

	<!-- Replace the static background image shown around the video. -->
	<set xpath="//window[@name='menuBackground']/texture[@name='bgTexture']/@texture">@modfolder:Textures/UI/DistrictZeroBackground.jpg</set>

	<!-- Optional tweaks (uncomment to use): -->
	<!-- <set xpath="//window[@name='menuBackground']/video[@name='videoTexture']/@loop">true</set> -->
	<!-- <set xpath="//window[@name='menuBackground']/video[@name='videoTexture']/@videoaspect">FitOutside</set> -->

	<!-- Remove the 2 news boxes from main menu -->
	<remove xpath="//window[@name='mainMenuNews']/rect[@name='game']"/>
	<remove xpath="//window[@name='mainMenuNews']/rect[@name='featured']"/>

</configs>
